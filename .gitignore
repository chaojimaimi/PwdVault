# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Tauri
src-tauri/target/
src-tauri/binaries/
src-tauri/crates/*/target/
extensions/native-host/target/

# Database files (user data)
*.db
vault.db
.gstack/

# Release artifacts (use GitHub Releases instead)
/releases/*.zip
/releases/*.dmg
/releases/*.exe
/releases/*.db.bak
/releases/*.app
/releases/PwdVault.app
/releases/pwdvault-native*
/releases/PwdVault-*-Extension-*/
/releases/pwdvault-native-*/
/releases/pairing-toast-*.html
# Checksum manifests for local release artifacts
/releases/SHA256SUMS*
# Release bundles and expanded subdirectories (any versioned subfolder)
/releases/*/
/releases/**/*.zip
/extensions/chrome/PwdVault-Chrome-Extension-*.zip
/extensions/firefox/PwdVault-Firefox-Extension-*.zip
/releases/**/*.dmg
/releases/**/*.exe
/releases/**/pwdvault-native*
/releases/**/PwdVault-*-Extension-*/
# Whole-dir catch-all (v1.7.0 lesson: per-type rules missed tar.gz/sig and
# git add -A swept a partial download into a commit)
/releases/
# Root-level release artifacts (accident-proofing: downloads live in releases/)
/*.app.tar.gz*
/*-setup.exe*
/*.dmg

# Python bytecode / caches (Phase 5 automation)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environment variables
.env
.env.*

# IDE / assistant local config
.claude/
.vscode/
src-tauri/icons-backup/
.zcode/
# TypeScript build info (composite incremental artifacts)
*.tsbuildinfo
